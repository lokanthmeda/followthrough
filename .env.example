# LLM / WhisperFlow proxy (OpenAI-compatible at 127.0.0.1:31415)
LLM_BASE_URL=http://127.0.0.1:31415
LLM_API_KEY=your_proxy_api_key_here
LLAMA_MODEL=auto

# Database – SQLite for local dev, Supabase for prod
DATABASE_URL=sqlite+aiosqlite:///./followthrough.db

# Tracker – use "mock" for demo without Linear credentials
TRACKER_PROVIDER=mock
LINEAR_API_KEY=
LINEAR_API_URL=https://api.linear.app

# Notifications
RESEND_API_KEY=
SLACK_WEBHOOK_URL=

# Frontend
BACKEND_URL=http://127.0.0.1:8000